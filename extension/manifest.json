{
	"manifest_version": 3,
	"name": "Invisible Ink — hidden character detector",
	"version": "1.0.0",
	"description": "Reveal and remove the invisible Unicode characters — zero-width spaces, tag characters, BOMs — that hide in text you copy.",
	"minimum_chrome_version": "119",
	"permissions": ["activeTab", "scripting", "contextMenus"],
	"background": {
		"service_worker": "background/service-worker.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "Invisible Ink",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content/hidden-character-detector.js"],
			"css": ["content/hidden-character-marks.css"],
			"run_at": "document_idle"
		}
	]
}
